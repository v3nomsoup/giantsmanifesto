# Public origin of the site, used for absolute links and the origin check.
SITE_URL=
# Directory for app.db and uploads (default ./data in dev, /data in the Docker image).
DATA_DIR=
# Secret that signs the anti-spam (ALTCHA) challenges; signing stays paused without it.
SESSION_SECRET=
# Set to 1 when behind a reverse proxy (Traefik) so client IPs come from X-Forwarded-For.
# Assumes exactly one proxy hop: the rightmost X-Forwarded-For entry is used.
TRUST_PROXY=
# Maximum requests per client per 15 minutes on form endpoints (default 10).
RATE_LIMIT_MAX=
# Proof-of-work difficulty for the ALTCHA challenge (default 100000).
ALTCHA_MAX_NUMBER=
# OAuth app credentials for GitHub sign-in.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# OAuth app credentials for LinkedIn sign-in.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# SMTP server for outgoing mail; signing stays paused without it.
SMTP_HOST=
# SMTP port (default 587).
SMTP_PORT=
# Set to true for implicit TLS (port 465).
SMTP_SECURE=
# SMTP login user.
SMTP_USER=
# SMTP login password.
SMTP_PASSWORD=
# Sender address of outgoing mail; signing stays paused without it.
MAIL_FROM=
# Maximum mails sent per hour (default 60).
MAIL_MAX_PER_HOUR=
# Comma-separated GitHub user IDs allowed into the admin area.
ADMIN_GITHUB_IDS=
# Address that receives admin notifications.
ADMIN_EMAIL=
# age public key the nightly backup is encrypted to.
BACKUP_AGE_RECIPIENT=
# Mailbox that receives the encrypted daily backup.
BACKUP_EMAIL=
# Largest backup attachment in MB before logos are skipped (default 10).
BACKUP_MAX_ATTACHMENT_MB=
